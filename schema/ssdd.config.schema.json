{
  "title": "ssdd.config.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "cli": {
      "default": "ssdd",
      "type": "string",
      "minLength": 1
    },
    "ssddVersion": {
      "type": "string"
    },
    "agents": {
      "default": [
        "claude"
      ],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commandPrefix": {
      "default": "ssdd",
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "implement": {
      "default": {},
      "type": "object",
      "properties": {
        "runTests": {
          "default": true,
          "type": "boolean"
        }
      }
    },
    "git": {
      "default": {},
      "type": "object",
      "properties": {
        "remote": {
          "default": "origin",
          "type": "string"
        },
        "push": {
          "default": true,
          "type": "boolean"
        },
        "tagPrefix": {
          "default": "ssdd-v",
          "type": "string",
          "minLength": 1
        }
      }
    },
    "test": {
      "default": {},
      "type": "object",
      "properties": {
        "runners": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "globs": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "tagStyle": {
                "default": "name",
                "type": "string",
                "enum": [
                  "name",
                  "comment"
                ]
              },
              "command": {
                "type": "string",
                "minLength": 1,
                "description": "Shell command; {filter} is replaced with the test filter"
              },
              "junit": {
                "type": "string",
                "minLength": 1,
                "description": "JUnit XML file the command writes, relative to the repo root"
              },
              "env": {
                "type": "object",
                "propertyNames": {
                  "type": "string"
                },
                "additionalProperties": {
                  "type": "string"
                }
              }
            },
            "required": [
              "name",
              "globs",
              "command",
              "junit"
            ]
          }
        }
      }
    }
  }
}
