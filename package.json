{
  "name": "ssdd",
  "version": "0.1.0",
  "description": "Simple spec-driven development CLI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ssdd": "bin/ssdd.mjs"
  },
  "files": [
    "bin",
    "dist/cli.mjs",
    "templates"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "bun src/cli/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "bun build src/cli/main.ts --target=node --format=esm --minify --outfile dist/cli.mjs",
    "smoke": "bash scripts/smoke.sh",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "bun": "^1.4.2",
    "commander": "^15.0.0",
    "fast-xml-parser": "^5.11.2",
    "fastest-levenshtein": "^1.0.16",
    "picocolors": "^1.1.1",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sPavl0v/ssdd.git"
  },
  "homepage": "https://github.com/sPavl0v/ssdd#readme",
  "bugs": {
    "url": "https://github.com/sPavl0v/ssdd/issues"
  },
  "keywords": [
    "spec-driven-development",
    "sdd",
    "ssdd",
    "spec driven development",
    "specs",
    "claude skill",
    "ai-agents",
    "claude-code",
    "cursor",
    "copilot",
    "sdd cli"
  ]
}
